# ---------------------------------------------------------------------------
# Vorlage. Kopieren nach .env.local (lokal) bzw. als Secrets hinterlegen.
# Hier stehen nur Namen und Erklärungen – niemals echte Werte.
#
# Alles ist optional. Ohne diese Variablen läuft die Website vollständig:
# Sofortpreis-Rechner, Ticket, Übergabeprotokoll, alle Werkzeuge. Es fehlen
# genau zwei Dinge – die Anmeldung eines Vorgangs und die Statusverfolgung.
# ---------------------------------------------------------------------------

# --- Vorgangsverwaltung (Supabase) -----------------------------------------
# Einrichtung Schritt für Schritt: supabase/README.md

# Öffentliche Adresse des Projekts. Steht auch im Browser – das ist so gewollt,
# der Realtime-Kanal braucht sie.
NEXT_PUBLIC_SUPABASE_URL=

# Der öffentliche Schlüssel (anon / publishable). Darf im Browser stehen: Er
# verleiht die Rechte der Rolle `anon`, und für die gibt es auf den
# Vorgangstabellen keine einzige Policy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Der geheime Schlüssel. Umgeht Row Level Security und gehört ausschließlich
# auf den Server. Niemals mit NEXT_PUBLIC_ davor – Next.js liefert alles mit
# diesem Präfix an den Browser aus.
#   Cloudflare: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# --- Nachrichten an Kunden --------------------------------------------------
# Jeder Weg ist einzeln zu- oder abschaltbar. Was nicht eingerichtet ist,
# meldet sich im Dashboard als „noch nicht eingerichtet“ – gesendet wird dann
# nichts, statt still zu verschwinden.

# E-Mail über Resend. Dieselben Variablen wie beim Kontaktformular.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=

# WhatsApp, SMS und Push laufen über einen eigenen HTTPS-Endpunkt, damit der
# Anbieter austauschbar bleibt (lib/notify/adapters/webhook.ts). Erwartet wird
# ein POST mit JSON:
#   { "kanal", "an", "betreff", "text", "vorgang", "status", "url" }
NOTIFY_WHATSAPP_WEBHOOK=
NOTIFY_WHATSAPP_TOKEN=
NOTIFY_SMS_WEBHOOK=
NOTIFY_SMS_TOKEN=
NOTIFY_PUSH_WEBHOOK=
NOTIFY_PUSH_TOKEN=

# --- Ziele des Builds -------------------------------------------------------
# Werden von den Build-Skripten gesetzt, nicht von Hand:
#   STATIC_EXPORT=true   npm run build:static
#   GITHUB_PAGES=true    Workflow .github/workflows/nextjs.yml
